{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a7dev-backend",
  "main": "src/preparation.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "a7dev-db",
      "database_id": "REPLACE_AFTER_D1_CREATE"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SCRIPTS",
      "bucket_name": "a7dev-scripts"
    }
  ]
}
