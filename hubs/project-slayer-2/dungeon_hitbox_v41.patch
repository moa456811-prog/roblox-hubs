 -- One reusable player constraint; the existing heartbeat owns its lifetime.
 State.DungeonHover = {}
+-- Local target geometry only; server damage validation remains authoritative.
+State.DungeonHover.restoreHitbox = function()
+    local h = State.DungeonHover
+    local entry = h.Hitbox
+    h.Hitbox = nil
+    if not entry then return end
+    pcall(function()
+        local part = entry.Root
+        if part.Size == entry.AppliedSize then part.Size = entry.Size end
+        if part.CanCollide == false then part.CanCollide = entry.CanCollide end
+        if part.Massless == true then part.Massless = entry.Massless end
+    end)
+end
+State.DungeonHover.applyHitbox = function(model, part)
+    local h = State.DungeonHover
+    if h.Hitbox and h.Hitbox.Root == part then return end
+    h.restoreHitbox()
+    if not aliveModel(model) or isPlayerCharacter(model)
+        or not part or not part.Parent or not part:IsA("BasePart") then return end
+    local size = part.Size
+    local entry = {Root=part,Size=size,CanCollide=part.CanCollide,Massless=part.Massless,
+        AppliedSize=Vector3.new(math.max(size.X,10),math.max(size.Y,14),math.max(size.Z,10))}
+    h.Hitbox = entry
+    local ok = pcall(function()
+        part.CanCollide = false
+        part.Massless = true
+        part.Size = entry.AppliedSize
+    end)
+    if not ok then h.restoreHitbox() end
+end
 State.DungeonHover.stop = function()
     local h = State.DungeonHover
+    h.restoreHitbox()
     for _, key in ipairs({"Position", "Orientation", "Attachment"}) do
         local object = h[key]
         h[key] = nil
